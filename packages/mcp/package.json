{
  "name": "@hyperblur/mcp",
  "version": "0.2.0",
  "description": "MCP server for Hyperblur: search, inspect and install copy-paste React effects, components, micro interactions and page blocks from any MCP client.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://hyperblur.dev",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hyperblur",
    "react",
    "shadcn",
    "effects",
    "components"
  ],
  "bin": {
    "hyperblur-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"process.getBuiltinModule('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"process.getBuiltinModule('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "node --watch src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --test \"test/**/*.test.ts\"",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperblur/Hyperblur.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Hyperblur/Hyperblur/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
